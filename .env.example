# 访问密码（必填）
NAV_PASSWORD=change-me

# 后台管理密码（可选）。不设置则与访问密码相同，用访问密码登录也能进后台
# ADMIN_PASSWORD=

# 页面标题
# SITE_TITLE=我的导航

# 登录有效天数，经常访问会自动续期
# SESSION_DAYS=30

# 前面有 Nginx / Caddy 反代时设为 true，登录限流才能拿到访客的真实 IP
# 没有反代时千万不要开，否则别人可以伪造 IP 绕过限流
# TRUST_PROXY=false

# 服务器访问不了 GitHub / jsDelivr 时，可以让下载图标走代理
# HTTPS_PROXY=http://127.0.0.1:7890
